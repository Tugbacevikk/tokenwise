# Copy to .env.server and fill in. Never commit the filled-in file.

# 32+ random characters; encrypts the organizations' model keys. Changing it makes stored keys
# unreadable (owners then enter them again). python -c "import secrets; print(secrets.token_urlsafe(48))"
TOKENWISE_SECRET_KEY=
# Where people open the dashboard; links in PR comments point here.
TOKENWISE_PUBLIC_URL=https://tokenwise.example.com

# GitHub App (Settings > Developer settings > GitHub Apps)
GITHUB_APP_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
# The app's private key: the PEM text itself, or a path the containers can read.
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app.pem

# Image the project checks run in (no network, read-only system). Must contain what the
# repositories' check commands need.
TOKENWISE_SANDBOX_IMAGE=python:3.12-slim
# Extra RepoDoctor sources; they read code, never run it.
TOKENWISE_SCAN_TOOLS=ruff,bandit
# OpenAI-compatible model servers owners may choose, comma separated. Empty = Anthropic only.
TOKENWISE_ALLOWED_MODEL_URLS=
